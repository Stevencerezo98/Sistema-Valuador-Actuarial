# ==============================================================
# CONFIGURACIÓN DEL SERVIDOR VALUADOR ACTUARIAL NIC 19 ECUADOR
# ==============================================================

# Puerto de ejecución (por defecto 3000)
PORT=3000
NODE_ENV=production

# URL pública de la aplicación
APP_URL=https://tu-dominio-o-servidor.com

# --------------------------------------------------------------
# SERVICIO DE NOTIFICACIONES POR CORREO ELECTRÓNICO (SMTP)
# --------------------------------------------------------------
# Correo del Perito Actuario que recibirá el aviso cuando el cliente suba nóminas
ACTUARIO_EMAIL=actuario@estudiosactuariales.ec

# Configuración del servidor de correo saliente (SMTP)
# Compatible con Gmail, Outlook / Office 365, Amazon SES, Brevo, SendGrid, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@tu-empresa.com
SMTP_PASS=tu_clave_de_aplicacion_o_token
SMTP_FROM="Valuador Actuarial NIC 19" <notificaciones@tu-empresa.com>

# NOTA: Si no se configuran credenciales SMTP, el sistema opera automáticamente
# en Modo de Pruebas Seguro con simulación de entrega y registro en auditoría.
